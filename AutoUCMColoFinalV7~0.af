STATE: {ColoPortal} ~~ {
	IF:	Always
		DO:	DoAll
				DoExpr {clearvar[StopwatchPortal]}
				DoExpr {clearvar[Spawn]}
				DoExpr {clearvar[Room]}
				DoExpr {clearvar[SpawnCount]}
				DoExpr {clearvar[RoomFinished]}
				Chat {/vt opt set navpriorityboost false}
				Chat {/vt opt set autofellowmanagement false}
				Chat {/vt opt set enablenav true}
				DoExpr {clearvar[StopwatchRoomStart]}
				Chat {/vt opt set lootonlyrarecorpses true}
				DoExpr {clearvar[RoomCounter]}
				DoExpr {clearvar[StopwatchPortal]}
				DoExpr {clearvar[StopwatchRoom]}
	IF:	All
			BlockE 00AF0000
			Expr {getvar[Leader]==1}
		DO:	DoAll
				DoExpr {setvar[StopwatchSecond, stopwatchcreate[]];stopwatchstart[getvar[StopwatchSecond]]}
				DoExpr {clearvar[Counter]}
	IF:	All
			Expr {getvar[Leader]==1}
			Expr {testvar[StopwatchRoom]<=0}
		DO:	DoExpr {setvar[StopwatchRoom, stopwatchcreate[]];stopwatchstart[getvar[StopwatchRoom]]}
	IF:	MobsInDist_Name 1 30 {}
		DO:	SetState {ResetRun}
	IF:	All
			Expr {getvar[FollowRunComplete]==1}
			Expr {getvar[Follower]==1}
			CellE 00AF0118
		DO:	SetState {Finished}
	IF:	BlockE 00B00000
		DO:	EmbedNav nav90___None_ {[none]}
	IF:	BlockE 00B10000
		DO:	EmbedNav nav91___None_ {[none]}
	IF:	BlockE 00B20000
		DO:	EmbedNav nav92___None_ {[none]}
	IF:	BlockE 00B30000
		DO:	EmbedNav nav93___None_ {[none]}
	IF:	BlockE 00B40000
		DO:	EmbedNav nav94___None_ {[none]}
	IF:	BlockE 00AF0000
		DO:	EmbedNav nav95___None_ {[none]}
	IF:	ExitPortal
		DO:	SetState {ColoBell}
	IF:	All
			BlockE 00AF0000
			Expr {getvar[OneToEighteen]==1}
		DO:	EmbedNav nav96___None_ {[none]}
	IF:	All
			SecsInStateGE 30
		DO:	DoExpr {setvar[Lag, 1]}
	IF:	All
			NoMobsInDist 30
			SecsInStateGE 30
			Any
				All
					SecsInStateGE 30
					Expr {getvar[Follower]<=0}
				SecsInStateGE 30
		DO:	SetState {ColoBell}
	IF:	All
			Expr {getvar[Follower]==1}
			Not BlockE 00AF0000
		DO:	EmbedNav nav97___None_ {[none]}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!finish\"$}
		DO:	DoExpr {setvar[FollowRunComplete, 1]}
~~ }
STATE: {ColoRoom1} ~~ {
	IF:	All
			Expr {getvar[Follower]==1}
			Expr {getvar[FollowStart]<=0}
		DO:	DoAll
				DoExpr {setvar[FollowStart, 1]}
				EmbedNav nav98___None_ {[none]}
				Chat {/vt opt set enablecombat false}
				Chat {/vt opt set enablebuffing false}
				DoExpr {setvar[FollowRecall, 1]}
				SetState {DefaultFollower}
				DoExpr {setvar[RoomFinished, 1]}
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room1: 2Rounds Golems use BluntRend, followed by 2Rounds Skeletons Blunt Rend.}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 1]}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, One]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
