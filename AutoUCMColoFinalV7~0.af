		DO:	DoExpr {setvar[Room, Fifteen]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 15]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom16} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room16: 2Rounds Hands, LightningRend then 2Rounds DemonSwarm, OlthoiSlayers}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Sixteen]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 16]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom17} ~~ {
	IF:	Expr {getvar[Follower]==1}
		DO:	DoExpr {setvar[FinalRoom, 1]}
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room17: Tuskers+ Virindi,FireRendTuskerFirst then Vslayers then 2Rounds Penguinds, FireRend}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Seventeen]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 17]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom18} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room18: 2Rounds Monougas, SB Frost/ARFrost/CSFrost or CBfrost then 3Rounds EliteGuardians/SBacid/CBacid/CSacid or ARacid}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Eighteen]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 18]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom2} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room2: 2Rounds Dolls use BluntRend, followed by 2Rounds Banderlings Blunt Rend.}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Two]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 2]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom3} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room3: 2Rounds Tummeroks use BluntRend, followed by 2Rounds Zharalim  FireRend.}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Three]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 3]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom4} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room4: 2Rounds Wasps use FireRend, followed by 2Rounds Drudges  FireRend.}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Four]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 4]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom5} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room5: 2Rounds Wisps use BluntRend, followed by 2Rounds Gromnies  BluntRend.}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Five]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 5]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom6} ~~ {
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 6]}
	IF:	All
			Expr {getvar[Follower]==1}
			Expr {getvar[FollowStart]<=0}
		DO:	DoAll
				EmbedNav nav99___None_ {[none]}
				SetState {DefaultFollower}
				DoExpr {setvar[FollowStart, 1]}
				DoExpr {setvar[FollowRecall, 1]}
				Chat {/vt opt set enablebuffing false}
				Chat {/vt opt set enablecombat false}
				DoExpr {setvar[RoomFinished, 1]}
	IF:	Expr {getvar[Follower]<=0}
		DO:	Chat {/vt opt set enablebuffing true}
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room6: 2Rounds Mosswarts, FireRend Mages Streak Then 2Rounds Lugians+Matties, LightningRend and FireRend Lugians First}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Six]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom7} ~~ {
	IF:	Expr {getvar[Follower]<=0}
		DO:	Chat {/vt opt set enablebuffing true}
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room7: 2Rounds Eaters, SlashRend then 2Rounds Viamonts LightRend}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Seven]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 7]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom8} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room8: 2Rounds Armordillos+Zefirs, LightningRend Then 2Rounds Clord and crystals, MeeleArcherVoid AcidRend Clord, then all BludgeAR or Rend Crystals}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Eight]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 8]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRoom9} ~~ {
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f Room9: 2Rounds Olthoi, OlthoiSlayers  Mages Streak Then 2Rounds: Shadows, Mages-ShadowSlayer+Streaks, Meele/Archer FireRend}
	IF:	Expr {getvar[Equip]==1}
		DO:	DoExpr {setvar[Room, Nine]}
	IF:	Always
		DO:	DoExpr {setvar[RoomNumber, 9]}
	IF:	Always
		DO:	SetState {ColoRouteFinish}
~~ }
STATE: {ColoRouteFinish} ~~ {
	IF:	Always
		DO:	Chat {/vt opt set NavCloseStopRange .0208333}
	IF:	All
			Expr {getvar[Follower]==1}
			NavEmpty
		DO:	DoAll
				SetState {DefaultFollower}
				EmbedNav nav100___None_ {[none]}
				CallState {Default3Route} {DefaultFollower}
				Chat {/vt opt set navclosestoprange .00625}
				DoExpr {setvar[Spawn, 4]}
				DoExpr {setvar[RoomFinished, 1]}
	IF:	All
			Expr {getvar[Leader]==1}
			NavEmpty
		DO:	DoAll
				SetState {ResetRun}
				EmbedNav nav101___None_ {[none]}
	IF:	Any
			All
				MobsInDist_Name 1 60 {}
				Not NeedToBuff
			All
				Not NeedToBuff
				SecsInStateGE 20
			NavEmpty
		DO:	DoAll
				SetState {ResetRun}
				Chat {/vt opt set enablenav false}
				Chat {/vt opt set navpriorityboost false}
	IF:	Expr {getvar[Follower]==1}
		DO:	Chat {/vt opt set enablelooting false}
~~ }
STATE: {dead} ~~ {
	IF:	Not CellE 00AF0118
		DO:	EmbedNav nav102___None_ {[none]}
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set enablenav true}
				SetState {Runback}
				Chat {/vt opt set enablecombat false}
~~ }
STATE: {Default} ~~ {
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set lootpriorityboost true}
				Chat {/vt opt set lootonlyrarecorpses true}
				Chat {/vt opt set navpriorityboost true}
				EmbedNav nav103__Clear_nav {Clear.nav}
				DoExpr {clearallvars[]}
	IF:	NavEmpty
		DO:	SetState {DefaultVariable}
	IF:	Any
			ChatMatch {^You have disbanded your Fellowship.}
			ChatMatch {^You are no longer a member of the.*Fellowship.}
			ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!cancel\"$}
		DO:	DoAll
				EmbedNav nav104___None_ {[none]}
				Return
~~ }
STATE: {Default2} ~~ {
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"!buff\"$}
		DO:	SetState {rebuff}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"!cancelbuff\"$}
		DO:	SetState {ForceBuffCancel}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"!reset\"$}
		DO:	SetState {Reset}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"!colo recall\"$}
		DO:	SetState {RecallColo}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"!turn in\"$}
		DO:	SetState {TurnIn}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"!door\"$}
		DO:	SetState {Door}
	IF:	Any
			All
				Not ChatMatch {^.*\s+(say|says|think|tells you), \".*A Door appears on the North wall.\"$}
				ChatMatch {A Door appears on the North wall.}
			All
				ChatMatch {^Your fellowship is now locked.}
		DO:	DoAll
				SetState {ColoPortal}
				Chat {/vt opt set enablebuffing false}
	IF:	Death
		DO:	SetState {dead}
	IF:	MobsInDist_Name 1 60 {}
		DO:	SetState {Default4}
	IF:	BlockE 00B00000
		DO:	SetState {Default3}
	IF:	BlockE 00B10000
		DO:	SetState {Default3}
	IF:	BlockE 00B20000
		DO:	SetState {Default3}
	IF:	BlockE 00B30000
		DO:	SetState {Default3}
	IF:	BlockE 00B40000
		DO:	SetState {Default3}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!OneToEighteen\"$}
		DO:	DoExpr {setvar[OneToEighteen, 1]}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!speedrun\"$}
		DO:	DoExpr {setvar[Speedrun, 1]}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!EconomyRun\"$}
		DO:	DoExpr {setvar[EconomyRun, 1]}
	IF:	ChatMatch {^.*().* (say|says|tells you), \"!quit fellow\"$}
		DO:	CallState {QuitFellow} {Default2}
	IF:	ChatMatch {^.*().* (say|says|tells you), \"!disband fellow\"$}
		DO:	CallState {QuitFellow} {Default2}
~~ }
STATE: {Default3} ~~ {
	IF:	MobsInDist_Name 1 60 {}
		DO:	DoAll
				Chat {/vt opt set idlepeacemode false}
				EmbedNav nav105___None_ {[none]}
				CallState {MonsterCall} {Default4}
				DoExpr {setvar[StopwatchMana, stopwatchcreate[]];stopwatchstart[getvar[StopwatchMana]]}
	IF:	ChatMatch {\[Fellowship\] (|).* (say|says), \"!reset\"$}
		DO:	SetState {ResetRun}
	IF:	All
			Expr {getvar[Leader]==1}
			Expr {testvar[StopwatchRoom]==1}
			Expr {getvar[RoomCounter]>=1}
			Any
				ChatMatch {^Congratulations!}
				ChatMatch {^A Door appears on the North wall.}
		DO:	ChatExpr {\/f\ Room\ +cstr[getvar[RoomNumber]]+\ completed\ in\ +cstrf[((stopwatchelapsedseconds[getvar[StopwatchRoom]]/60)-((stopwatchelapsedseconds[getvar[StopwatchRoom]]-getvar[RoomCounter])/60)), \F\0]+m\ +cstrf[(stopwatchelapsedseconds[getvar[StopwatchRoom]]-getvar[RoomCounter]), \F\0]+s}
	IF:	All
			Any
				ChatMatch {^Congratulations! You have beaten the Colosseum!}
				ChatMatch {^A Door appears on the North wall.}
			Expr {getvar[Counter]>=1}
			Expr {getvar[Leader]==1}
			Expr {getvar[RoomCounter]>=1}
		DO:	DoAll
				ChatExpr {\/f\ Time\ Remaining\ +cstrf[59-((stopwatchelapsedseconds[getvar[StopwatchSecond]]/60)-((stopwatchelapsedseconds[getvar[StopwatchSecond]]-getvar[Counter])/60)), \F\0]+m\ +cstrf[60-(stopwatchelapsedseconds[getvar[StopwatchSecond]]-getvar[Counter]), \F\0]+s}
	IF:	All
			Not ChatMatch {^.*\s+(say|says|think|tells you), \".*Congratulations! You have beaten the Colosseum!\"$}
			ChatMatch {Congratulations! You have beaten the Colosseum!}
		DO:	SetState {Finished}
	IF:	Any
			All
				Not ChatMatch {^.*\s+(say|says|think|tells you), \".*A Door appears on the North wall.\"$}
				ChatMatch {A Door appears on the North wall.}
			SecsInStateGE 14
			All
				Expr {testvar[StopwatchPortal]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchPortal]]>=15}
			All
				Expr {testvar[StopwatchRoomStart]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchRoomStart]]>=30}
		DO:	SetState {ColoPortal}
	IF:	Death
		DO:	SetState {dead}
	IF:	All
			Expr {testvar[StopwatchRoom]==1}
			Expr {testvar[Counter]==1}
			Expr {stopwatchelapsedseconds[getvar[StopwatchRoom]]-getvar[RoomCounter]>=60}
		DO:	DoAll
				DoExpr {setvar[RoomCounter, getvar[RoomCounter]+60]}
				SetState {Default3}
	IF:	All
			Expr {testvar[StopwatchSecond]==1}
			Expr {testvar[Counter]==1}
			Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]-getvar[Counter]>=60}
		DO:	DoAll
				SetState {Default3}
				DoExpr {setvar[Counter, getvar[Counter]+60]}
	IF:	BlockE 00AF0000
		DO:	SetState {Finished}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!speedrun\"$}
		DO:	DoExpr {setvar[Speedrun, 1]}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!EconomyRun\"$}
		DO:	DoExpr {setvar[EconomyRun, 1]}
	IF:	Expr {getvar[Lag]==1}
		DO:	EmbedNav nav106___None_ {[none]}
	IF:	All
			Any
				Expr {getvar[Spawn]==1}
				Expr {getvar[Spawn]==3}
			Not Expr {getvar[SpawnCount]==A}
			Expr {getvar[Mage]==1}
		DO:	Chat {/vt opt set Recharge-norm-mana 60}
	IF:	All
			SecsInStateGE 1
			Expr {testvar[SpawnCount]==1}
			Expr {getvar[Equip]==1}
			Expr {testvar[Room]==1}
		DO:	ChatExpr {\/vt\ equipitemsfor\ +getvar[Room]+getvar[SpawnCount]}
	IF:	All
			SecsInStateGE 1
			Expr {getvar[RoomFinished]<=0}
			Expr {testvar[SpawnCount]<=0}
			Expr {getvar[Equip]==1}
			Expr {testvar[Room]==1}
		DO:	ChatExpr {\/vt\ equipitemsfor\ +getvar[Room]}
	IF:	All
			SecsInStateGE 2
			Expr {testvar[SpawnCount]==1}
			Expr {getvar[Equip]==1}
			Expr {testvar[Room]==1}
		DO:	DoAll
				ChatExpr {\/vt\ equipitemsfor\ +getvar[Room]+getvar[SpawnCount]}
				SetState {Default3}
	IF:	All
			SecsInStateGE 2
			Expr {getvar[RoomFinished]<=0}
			Expr {testvar[SpawnCount]<=0}
			Expr {getvar[Equip]==1}
			Expr {testvar[Room]==1}
		DO:	DoAll
				ChatExpr {\/vt\ equipitemsfor\ +getvar[Room]}
				SetState {Default3}
	IF:	All
			Expr {getvar[Equip]<=0}
			Any
				Expr {getvar[Spawn]==2}
				Expr {getvar[Spawn]==4}
				Expr {getvar[Spawn]<=0}
		DO:	DoAll
				Chat {/vt opt set switchwandstodebuff true}
				Chat {/vt opt set idlepeacemode true}
	IF:	Expr {getvar[Follower]==1}
		DO:	SetState {DefaultFollower}
	IF:	All
			Expr {getvar[Leader]==1}
			Expr {getvar[Spawn]==4}
			Expr {getvar[RoomNumber]==18}
			Expr {getvar[ClearSent]<=0}
		DO:	DoAll
				Chat {/f Final spawn cleared.}
				DoExpr {setvar[ClearSent, 1]}
	IF:	All
			SecsInStateGE 1
			NavEmpty
			Expr {getvar[Spawn]>=1}
			Expr {testvar[Heading]==1}
			Expr {getvar[Spawn]<=3}
		DO:	ChatExpr {\/mt face +cstr[getvar[Heading]]}
	IF:	All
			NavEmpty
			SecsInStateGE 1
			Expr {getvar[Spawn]<=0}
			Expr {testvar[Heading]==1}
			Expr {getvar[Leader]<=0}
		DO:	ChatExpr {\/mt face +cstr[getvar[AltHeading]]}
	IF:	All
			Expr {testvar[Heading]==1}
			SecsInStateGE 3
		DO:	SetState {Default3}
~~ }
STATE: {Default3Route} ~~ {
	IF:	BlockE 00AF0000
		DO:	SetState {Default}
	IF:	All
			Expr {getvar[Melee]==1}
			NavEmpty
		DO:	EmbedNav nav107___None_ {[none]}
	IF:	Expr {getvar[Spawn]<=3}
		DO:	Return
	IF:	BlockE 00B30000
		DO:	EmbedNav nav108___None_ {[none]}
	IF:	BlockE 00B40000
		DO:	EmbedNav nav109___None_ {[none]}
	IF:	BlockE 00B20000
		DO:	EmbedNav nav110___None_ {[none]}
	IF:	BlockE 00B10000
		DO:	EmbedNav nav111___None_ {[none]}
	IF:	All
			BlockE 00B00000
		DO:	EmbedNav nav112___None_ {[none]}
	IF:	Expr {getvar[Equip]<=0}
		DO:	DoAll
				Return
	IF:	Always
		DO:	DoExpr {clearvar[SpawnCount]}
	IF:	Expr {getvar[Room]==Six}
		DO:	DoAll
				DoExpr {setvar[Room, Seven]}
				Return
	IF:	Expr {getvar[Room]==Seven}
		DO:	DoAll
				DoExpr {setvar[Room, Eight]}
				Return
	IF:	Expr {getvar[Room]==Eight}
		DO:	DoAll
				DoExpr {setvar[Room, Nine]}
				Return
	IF:	Expr {getvar[Room]==Nine}
		DO:	DoAll
				DoExpr {setvar[Room, Ten]}
				Return
	IF:	Expr {getvar[Room]==Ten}
		DO:	DoAll
				DoExpr {setvar[Room, Eleven]}
				Return
	IF:	Expr {getvar[Room]==Eleven}
		DO:	DoAll
				DoExpr {setvar[Room, Twelve]}
				Return
	IF:	Expr {getvar[Room]==Twelve}
		DO:	DoAll
				DoExpr {setvar[Room, Thirteen]}
				Return
	IF:	Expr {getvar[Room]==Thirteen}
		DO:	DoAll
				DoExpr {setvar[Room, Fourteen]}
				Return
	IF:	Expr {getvar[Room]==Fourteen}
		DO:	DoAll
				DoExpr {setvar[Room, Fifteen]}
				Return
	IF:	Expr {getvar[Room]==Fifteen}
		DO:	DoAll
				DoExpr {setvar[Room, Sixteen]}
				Return
	IF:	Expr {getvar[Room]==Sixteen}
		DO:	DoAll
				DoExpr {setvar[Room, Seventeen]}
				Return
	IF:	Expr {getvar[Room]==Seventeen}
		DO:	DoAll
				DoExpr {setvar[Room, Eighteen]}
				Return
	IF:	Expr {getvar[Room]==One}
		DO:	DoAll
				DoExpr {setvar[Room, Two]}
				Return
	IF:	Expr {getvar[Room]==Two}
		DO:	DoAll
				DoExpr {setvar[Room, Three]}
				Return
	IF:	Expr {getvar[Room]==Three}
		DO:	DoAll
				DoExpr {setvar[Room, Four]}
				Return
	IF:	Expr {getvar[Room]==Four}
		DO:	DoAll
				DoExpr {setvar[Room, Five]}
				Return
	IF:	Expr {getvar[Equip]>=1}
		DO:	Return
~~ }
STATE: {Default4} ~~ {
	IF:	All
			NoMobsInDist 50
			All
				Expr {testvar[StopwatchMana]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchMana]]<=13}
			Expr {getvar[Leader]==1}
		DO:	ChatExpr {\/f\ \!Nice\ Skip\!\ \-\ time\ for\ that\ spawn\ \(+cstrf[stopwatchelapsedseconds[getvar[StopwatchMana]], \F\0]+s\)}
	IF:	Death
		DO:	SetState {dead}
	IF:	NoMobsInDist 60
		DO:	DoAll
				Chat {/vt opt set enablenav true}
				Chat {/vt opt set summonpets false}
				Chat {/vt opt set Recharge-Norm-Mana 25}
				DoExpr {setvar[StopwatchPortal, stopwatchcreate[]];stopwatchstart[getvar[StopwatchPortal]]}
				CallState {Default3Route} {Default3}
	IF:	BlockE 00AF0000
		DO:	SetState {Finished}
	IF:	All
			Expr {testvar[Stopwatch]==1}
			Expr {stopwatchelapsedseconds[getvar[Stopwatch]]>=14}
		DO:	Chat {/vt opt set summonpets true}
	IF:	All
			Expr {testvar[StopwatchMana]==1}
			Expr {stopwatchelapsedseconds[getvar[StopwatchMana]]>=14}
		DO:	Chat {/vt opt set Recharge-Norm-Mana 30}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!speedrun\"$}
		DO:	DoExpr {setvar[Speedrun, 1]}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!EconomyRun\"$}
		DO:	DoExpr {setvar[EconomyRun, 1]}
	IF:	All
			Expr {testvar[StopwatchSecond]==1}
			Expr {testvar[Counter]==1}
			Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]-getvar[Counter]>=60}
		DO:	DoExpr {setvar[Counter, getvar[Counter]+60]}
	IF:	Any
			Expr {getvar[Spawn]==2}
			Expr {getvar[Spawn]==3}
		DO:	DoExpr {setvar[SpawnCount, B]}
	IF:	All
			Expr {getvar[Spawn]==1}
			MobsInDist_Name 1 51 {Ravager}
		DO:	DoExpr {setvar[SpawnCount, A]}
	IF:	Expr {getvar[Spawn]==4}
		DO:	DoAll
				DoExpr {clearvar[SpawnCount]}
				DoExpr {setvar[RoomFinished, 1]}
	IF:	Expr {getvar[Equip]==1}
		DO:	Chat {/vt opt set switchwandstodebuff false}
	IF:	All
			All
				Expr {testvar[StopwatchRoom]==1}
				Expr {testvar[Counter]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchRoom]]-getvar[RoomCounter]>=60}
			Expr {getvar[Leader]==1}
		DO:	DoAll
				DoExpr {setvar[RoomCounter, getvar[RoomCounter]+60]}
	IF:	Expr {getvar[Follower]==1}
		DO:	SetState {DefaultFollower}
	IF:	All
			MobsInDist_Name 1 51 {Olthoi [SR].*}
			Expr {getvar[Larvae]==1}
			Expr {getcharskill_traininglevel[47]==3}
			Expr {testvar[DisableAttackSpeed]==0}
		DO:	DoAll
				Chat {/vt setattackbar .9}
				DoExpr {clearvar[Larvae]}
	IF:	All
			MobsInDist_Name 1 51 {Olthoi Progenitor}
			Expr {getcharskill_traininglevel[47]==3}
			Expr {testvar[Attack]==0}
			Expr {testvar[DisableAttackSpeed]==0}
		DO:	DoAll
				DoExpr {setvar[AttackSpeed, .9];setvar[Attack, 1]}
				ChatExpr {\/vt setattackbar +cstr[getvar[AttackSpeed]]}
	IF:	All
			ChatMatch {^[^\[].+evaded your attack\.$}
			Expr {getcharskill_traininglevel[47]==3}
			Expr {getvar[AttackSpeed]<=.9}
			Expr {testvar[DisableAttackSpeed]==0}
		DO:	DoAll
				DoExpr {setvar[AttackSpeed, getvar[AttackSpeed]+.1]}
				SetState {Default4}
				ChatExpr {\/vt setattackbar +cstr[getvar[AttackSpeed]]}
~~ }
STATE: {DefaultFollower} ~~ {
	IF:	All
			Expr {getvar[FollowRunComplete]==1}
			Expr {getvar[RoomNumber]<=16}
			MobsInDist_Name 1 51 {}
		DO:	DoExpr {clearvar[FollowRunComplete]}
	IF:	MobsInDist_Name 1 51 {}
		DO:	DoAll
				SetState {dead}
				Chat {/vt opt set enablecombat false}
				Chat {/vt opt set enablelooting false}
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set navpriorityboost false}
				Chat {/vt opt set enablelooting true}
				Chat {/vt opt set lootonlyrarecorpses false}
				Chat {/vt opt set lootpriorityboost true}
				Chat {/vt opt set approachdistance .375}
				Chat {/vt opt set idlepeacemode true}
				Chat {/vt cancelbuff}
				Chat {/vt opt set LootFellowCorpses true}
				Chat {/vt opt set enablelooting true}
				Chat {/vt opt set enablecombat false}
	IF:	Expr {getvar[FollowRunComplete]==1}
		DO:	SetState {ColoPortal}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!finish\"$}
		DO:	DoAll
				DoExpr {setvar[FollowRunComplete, 1]}
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!turn in\"$}
		DO:	DoAll
				DoExpr {clearvar[FollowRunComplete]}
				DoExpr {clearvar[FollowStart]}
				SetState {TurnIn}
	IF:	All
			Expr {getvar[RoomCheck]>getvar[RoomNumber]}
			Expr {testvar[RoomCheck]==1}
		DO:	SetState {ColoPortal}
	IF:	All
			CellE 00AF0118
			Expr {getvar[FollowRecall]==1}
			Expr {getvar[OneToEighteen]<=0}
		DO:	DoAll
				EmbedNav nav113___None_ {[none]}
				DoExpr {clearvar[FollowRecall]}
				Chat {/vt opt set navclosestoprange .00625}
				DoExpr {setvar[RoomNumber, 5]}
	IF:	All
			Expr {getvar[FollowRecall]==1}
			Expr {getvar[OneToEighteen]==1}
			CellE 00AF0118
		DO:	DoAll
				EmbedNav nav114___None_ {[none]}
				DoExpr {clearvar[FollowRecall]}
				Chat {/vt opt set navclosestoprange .00625}
	IF:	ChatMatch {^\[Fellowship\].*(|).* (say|says), \"Final spawn cleared.\"$}
		DO:	DoAll
				EmbedNav nav115___None_ {[none]}
				Chat {/vt opt set enablelooting false}
	IF:	Expr {getvar[RoomFinished]<=0}
		DO:	EmbedNav nav116___None_ {[none]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 6 completed}
		DO:	DoExpr {setvar[RoomCheck, 6]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 7 completed}
		DO:	DoExpr {setvar[RoomCheck, 7]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 8 completed}
		DO:	DoExpr {setvar[RoomCheck, 8]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 9 completed}
		DO:	DoExpr {setvar[RoomCheck, 9]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 10 completed}
		DO:	DoExpr {setvar[RoomCheck, 10]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 11 completed}
		DO:	DoExpr {setvar[RoomCheck, 11]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 12 completed}
		DO:	DoExpr {setvar[RoomCheck, 12]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 13 completed}
		DO:	DoExpr {setvar[RoomCheck, 13]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 15 completed}
		DO:	DoExpr {setvar[RoomCheck, 15]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 14 completed}
		DO:	DoExpr {setvar[RoomCheck, 14]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 16 completed}
		DO:	DoExpr {setvar[RoomCheck, 16]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 17 completed}
		DO:	DoExpr {setvar[RoomCheck, 17]}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"Room 18 completed}
		DO:	DoAll
				DoExpr {setvar[FollowRunComplete, 1]}
				EmbedNav nav117___None_ {[none]}
	IF:	ChatMatch {^You do not have access to the Colosseum's}
		DO:	SetState {Finished}
	IF:	All
			ChatMatch {^\[Fellowship\].*(|).*(say|says), \"Time Remaining}
			Expr {getvar[FinalRoom]==1}
		DO:	DoAll
				DoExpr {clearvar[FinalRoom]}
				DoExpr {setvar[FollowRunComplete, 1]}
	IF:	Death
		DO:	SetState {dead}
~~ }
STATE: {DefaultVariable} ~~ {
	IF:	ItemCountGE 1 {Egg}
		DO:	DoExpr {setvar[Leader, 1]}
	IF:	ItemCountGE 1 {Pink Taper}
		DO:	DoExpr {setvar[Heading, 45]}
	IF:	ItemCountGE 1 {Green Taper}
		DO:	DoExpr {setvar[Heading, 135]}
	IF:	ItemCountGE 1 {Indigo Taper}
		DO:	DoExpr {setvar[Heading, 225]}
	IF:	ItemCountGE 1 {Brown Taper}
		DO:	DoExpr {setvar[Heading, 315]}
	IF:	ItemCountGE 1 {Violet Taper}
		DO:	DoExpr {setvar[Melee, 1]}
	IF:	ItemCountGE 1 {Orange Taper}
		DO:	DoExpr {setvar[Archer, 1]}
	IF:	ItemCountGE 1 {Yellow Taper}
		DO:	DoExpr {setvar[Mage, 1]}
	IF:	All
			ItemCountGE 1 {Grey Taper}
			ItemCountLE 0 {Blue Taper}
			ItemCountLE 0 {Red Taper}
		DO:	DoExpr {setvar[Heading, 0]}
	IF:	All
			ItemCountGE 1 {Red Taper}
			ItemCountLE 0 {Grey Taper}
			ItemCountLE 0 {Blue Taper}
		DO:	DoExpr {setvar[Heading, 120]}
	IF:	All
			ItemCountGE 1 {Blue Taper}
			ItemCountLE 0 {Red Taper}
			ItemCountLE 0 {Grey Taper}
		DO:	DoExpr {setvar[Heading, 240]}
	IF:	All
			ItemCountGE 1 {Red Taper}
			ItemCountGE 1 {Blue Taper}
			ItemCountLE 0 {Grey Taper}
		DO:	DoExpr {setvar[Heading, 180]}
	IF:	All
			ItemCountGE 1 {Red Taper}
			ItemCountGE 1 {Grey Taper}
			ItemCountLE 0 {Blue Taper}
		DO:	DoExpr {setvar[Heading, 60]}
	IF:	All
			ItemCountGE 1 {Blue Taper}
			ItemCountGE 1 {Grey Taper}
			ItemCountLE 0 {Red Taper}
		DO:	DoExpr {setvar[Heading, 300]}
	IF:	Expr {getcharstringprop[1]==CharOne}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharTwo}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharThree}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharFour}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharFive}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharSix}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharSeven}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharEight}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	Expr {getcharstringprop[1]==CharNine}
		DO:	DoExpr {setvar[Heading, ];setvar[AltHeading, ]}
	IF:	All
			Expr {testvar[Heading]==1}
			Expr {testvar[AltHeading]==0}
		DO:	DoExpr {setvar[AltHeading, getvar[Heading]]}
	IF:	Never
		DO:	DoExpr {setvar[OneToEighteen, 1]}
	IF:	ItemCountGE 1 {Turquoise Taper}
		DO:	DoAll
				DoExpr {setvar[Follower, 1]}
				SetState {Reset}
	IF:	Never
		DO:	DoExpr {setvar[Equip, 1]}
	IF:	Never
		DO:	DoExpr {setvar[Speedrun, 1]}
	IF:	Never
		DO:	DoExpr {setvar[EconomyRun, 1]}
	IF:	Never
		DO:	DoExpr {setvar[SummonFalse, 1]}
	IF:	Never
		DO:	DoExpr {setvar[TurnInBuffing, 1]}
	IF:	Never
		DO:	DoExpr {setvar[DisableAttackSpeed, 1]}
	IF:	Always
		DO:	SetState {Reset}
~~ }
STATE: {Door} ~~ {
	IF:	BlockE 00AF0000
		DO:	EmbedNav nav118___None_ {[none]}
	IF:	All
			BlockE 00AF0000
			Expr {getvar[OneToEighteen]==1}
		DO:	EmbedNav nav119___None_ {[none]}
	IF:	Not BlockE 00AF0000
		DO:	EmbedNav nav120__ColoRecall_nav {ColoRecall.nav}
	IF:	NavEmpty
		DO:	SetState {rebuff}
	IF:	ChatMatch {^Your fellowship is now locked.}
		DO:	DoAll
				SetState {ColoPortal}
				Chat {/vt forcebuff}
~~ }
STATE: {Finished} ~~ {
	IF:	All
			Expr {getvar[Follower]==1}
		DO:	DoAll
				DoExpr {clearvar[FollowRunComplete]}
				DoExpr {clearvar[FollowStart]}
				SetState {TurnIn}
				DoExpr {clearvar[FollowRecall]}
				DoExpr {clearvar[FinalRoom]}
				DoExpr {clearvar[RoomFinished]}
				DoExpr {clearvar[Spawn]}
				Chat {/vt opt set enablelooting true}
				DoExpr {clearvar[RoomCheck]}
				EmbedNav nav121___None_ {[none]}
	IF:	All
			BlockE 00B30000
		DO:	EmbedNav nav122__Arena4EndPortal_nav {Arena4EndPortal.nav}
	IF:	All
			Not BlockE 00B30000
			Not BlockE 00000000
			Not BlockE 00000000
		DO:	DoAll
				EmbedNav nav123__ColoEndPortals_nav {ColoEndPortals.nav}
	IF:	Expr {getvar[Leader]==1}
		DO:	Chat {/f !finish}
	IF:	All
			BlockE 00B40000
		DO:	EmbedNav nav124__ColoEndPortalArena5_nav {ColoEndPortalArena5.nav}
	IF:	SecsInStateGE 45
		DO:	SetState {FinishedRestart}
	IF:	Always
		DO:	DoAll
				DoExpr {clearvar[Stopwatch]}
				DoExpr {clearvar[StopwatchMana]}
				DoExpr {clearvar[Spawn]}
				DoExpr {clearvar[SpawnCount]}
				DoExpr {clearvar[StopwatchPortal]}
				DoExpr {clearvar[RoomFinished]}
				DoExpr {clearvar[Room]}
				Chat {/vt opt set enablenav true}
				Chat {/mt combatstate peace}
				DoExpr {clearvar[RoomCounter]}
				DoExpr {clearvar[StopwatchRoom]}
				DoExpr {clearvar[ClearSent]}
				DoExpr {clearvar[RoomNumber]}
	IF:	Any
			BlockE 00AF0000
		DO:	SetState {TurnIn}
~~ }
STATE: {FinishedRestart} ~~ {
	IF:	Always
		DO:	SetState {Finished}
~~ }
STATE: {ForceBuffCancel} ~~ {
	IF:	Always
		DO:	DoAll
				Chat {/vt cancelforcebuff}
				SetState {Default2}
				Chat {/vt opt set enablebuffing false}
~~ }
STATE: {MonsterCall} ~~ {
	IF:	Expr {getvar[SummonFalse]==1}
		DO:	Chat {/vt opt set summonpets false}
	IF:	Expr {getvar[Melee]==1}
		DO:	Chat {/vt opt set TargetSelectMethod 3}
	IF:	All
			Expr {getvar[EconomyRun]<=0}
			Expr {getvar[Speedrun]<=0}
		DO:	Chat {/vt opt set summonpets true}
	IF:	All
			Expr {getvar[EconomyRun]==1}
			Any
				MobsInDist_Name 1 51 {Virindi Paradox}
				MobsInDist_Name 1 51 {Virindi Quidiox}
				MobsInDist_Name 1 51 {Tukora Lieutenant}
				MobsInDist_Name 1 51 {Tukora Sentinel}
				MobsInDist_Name 1 51 {Uber Penguin}
				MobsInDist_Name 1 51 {Tremendous Monouga}
				MobsInDist_Name 1 51 {Elite Guardian}
		DO:	Chat {/vt opt set summonpets true}
	IF:	Expr {getvar[Speedrun]==1}
		DO:	DoExpr {setvar[Stopwatch, stopwatchcreate[]];stopwatchstart[getvar[Stopwatch]]}
	IF:	Expr {testvar[StopwatchRoomStart]==1}
		DO:	DoExpr {clearvar[StopwatchRoomStart]}
	IF:	All
			Expr {getvar[Speedrun]==1}
			Any
				MobsInDist_Name 1 51 {Titanium Armoredillo}
				MobsInDist_Name 1 51 {Olthoi Larvae}
				MobsInDist_Name 1 51 {Olthoi Slayer}
				MobsInDist_Name 1 51 {Disgraced Nanjou Shou-jen}
				MobsInDist_Name 1 51 {Ruschk Draktehn}
				MobsInDist_Name 1 51 {Tukora Sentinel}
				MobsInDist_Name 1 51 {Inflamed Ursuin}
				MobsInDist_Name 1 51 {Enraged Ancient Soul}
				MobsInDist_Name 1 51 {Viamontian Hand}
				MobsInDist_Name 1 51 {Mukkir Laktar}
				MobsInDist_Name 1 51 {Demon Swarm}
				MobsInDist_Name 2 51 {Elite Guardian}
		DO:	Chat {/vt opt set summonpets true}
	IF:	Any
			All
				Not MobsInDist_Name 1 51 {Elite Guardian}
				MobsInDist_Name 1 51 {}
			MobsInDist_Name 2 51 {Elite Guardian}
		DO:	DoExpr {setvar[Spawn, getvar[Spawn]+1]}
	IF:	Expr {getvar[Lag]==1}
		DO:	DoExpr {clearvar[Lag]}
	IF:	Any
			Expr {getcharskill_traininglevel[47]<=2}
			Expr {getvar[DisableAttackSpeed]==1}
		DO:	DoAll
				Return
				Chat {/vt opt set enablecombat true}
				Chat {/vt opt set Recharge-Norm-Mana 10}
				Chat {/vt opt setidlepeacemode false}
				Chat {/vt opt set switchwandstodebuff false}
				Chat {/vt opt set navclosestoprange .00625}
	IF:	Never
		DO:	DoExpr {setvar[AttackSpeed, 0]}
	IF:	MobsInDist_Name 1 5 {Olthoi Larvae}
		DO:	DoExpr {setvar[AttackSpeed, .1];setvar[Larvae, 1]}
	IF:	Never
		DO:	DoExpr {setvar[AttackSpeed, .2]}
	IF:	Never
		DO:	DoExpr {setvar[AttackSpeed, .3]}
	IF:	Never
		DO:	DoExpr {setvar[AttackSpeed, .4]}
	IF:	Any
			MobsInDist_Name 1 51 {Mosswart S.*}
		DO:	DoExpr {setvar[AttackSpeed, .5]}
	IF:	Any
			MobsInDist_Name 1 5 {.*Shadow$}
			MobsInDist_Name 1 51 {Mosswart [^S]\w+}
		DO:	DoExpr {setvar[AttackSpeed, .6]}
	IF:	All
			MobsInDist_Name 1 51 {Tortured Spirit}
			MobsInDist_Name 1 51 {Swarm Demon}
			MobsInDist_Name 1 51 {^.*Crystal Shard}
			MobsInDist_Name 1 5 {^.*Sleech}
		DO:	DoExpr {setvar[AttackSpeed, .7]}
	IF:	Any
			MobsInDist_Name 1 51 {War Mattekar}
			MobsInDist_Name 1 51 {^.*Eater$}
			MobsInDist_Name 1 51 {^.*Armoredillo$}
			MobsInDist_Name 1 51 {Ravager}
			MobsInDist_Name 1 51 {Enraged Ancient Soul}
			MobsInDist_Name 1 51 {Elite Guardians}
		DO:	DoExpr {setvar[AttackSpeed, .8]}
	IF:	Any
			MobsInDist_Name 1 5 {Virindi.*}
			MobsInDist_Name 1 51 {Annihilator}
			MobsInDist_Name 1 51 {Tremendous Monouga}
			MobsInDist_Name 1 51 {Viamontian Tribune}
			MobsInDist_Name 1 51 {Stomper}
			MobsInDist_Name 1 51 {Inflamed Ursuin}
			MobsInDist_Name 1 51 {Mosswart [^S].*}
			MobsInDist_Name 1 51 {Olthoi S.*}
			MobsInDist_Name 1 51 {Elite Guardian}
		DO:	DoExpr {setvar[AttackSpeed, .9]}
	IF:	Any
			MobsInDist_Name 1 51 {Disgraced.*}
			MobsInDist_Name 1 51 {Ruschk.*}
			MobsInDist_Name 1 51 {Mukkir.*}
			MobsInDist_Name 1 51 {Uber Penguin}
			MobsInDist_Name 1 51 {Tukora.*}
			MobsInDist_Name 1 51 {Viamontian Hand}
			MobsInDist_Name 1 51 {Enraged Ancient Soul}
		DO:	DoExpr {setvar[AttackSpeed, 1]}
	IF:	Expr {getcharskill_traininglevel[47]==3}
		DO:	ChatExpr {\/vt setattackbar +cstr[getvar[AttackSpeed]]}
	IF:	Always
		DO:	DoAll
				Return
				Chat {/vt opt set enablecombat true}
				Chat {/vt opt set Recharge-Norm-Mana 10}
				Chat {/vt opt set switchwandstodebuff false}
				Chat {/vt opt set idlepeacemode false}
				Chat {/vt opt set navclosestoprange .00625}
~~ }
STATE: {QuitFellow} ~~ {
	IF:	Always
		DO:	DoAll
				Chat {/f someone is attempting to have me quit/disband fellow say !cancel in fellow chat if i should ignore this}
				Chat {/r please reissue the command in the next 10 seconds to confirm}
	IF:	SecsInStateGE 10
		DO:	Return
	IF:	ChatMatch {^.*().* (say|says|tells you), \"!quit fellow\"$}
		DO:	EmbedNav nav125___None_ {[none]}
	IF:	ChatMatch {^.*().* (say|says|tells you), \"!disband fellow\"$}
		DO:	EmbedNav nav126___None_ {[none]}
	IF:	ChatMatch {^Your fellowship is now locked.}
		DO:	SetState {ColoPortal}
~~ }
STATE: {rebuff} ~~ {
	IF:	MobsInDist_Name 1 60 {}
		DO:	SetState {ForceBuffCancel}
	IF:	Expr {getvar[TurnInBuffing]<=0}
		DO:	DoAll
				Chat {/vt opt set enablebuffing true}
				Chat {/vt forcebuff}
	IF:	Expr {getvar[TurnInBuffing]==1}
		DO:	DoAll
				Chat {/vt opt set rebufftimeremainingseconds 4500}
				Chat {/vt opt set enablebuffing true}
	IF:	Expr {getvar[Follower]==1}
		DO:	DoAll
				Chat {/vt cancelbuff}
				Chat {/vt opt set enablebuffing false}
	IF:	ItemCountGE 1 {Egg}
		DO:	DoAll
				Chat {/vt opt set enablebuffing false} 
				SetState {TicketCheck}
	IF:	ItemCountLE 1 {Egg}
		DO:	SetState {Default2}
	IF:	ChatMatch {^\[Fellowship\] (|).* (say|says), \"!cancelbuff\"$}
		DO:	SetState {ForceBuffCancel}

~~ }
STATE: {RecallColo} ~~ {
	IF:	Any
			CellE 00AF0118
		DO:	SetState {Default}
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set enablecombat false}
				Chat {/vt opt set enablenav true}
				Chat {/vt opt set enablebuffing false}
				Chat {/vt opt set enablelooting false}
				EmbedNav nav127___None_ {[none]}
				Chat {/vt opt set opendoors false}
~~ }
STATE: {Reset} ~~ {
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set enablenav true}
				Chat {/vt opt set enablelooting true}
				Chat {/vt opt set enablebuffing false}
				Chat {/vt opt set enablecombat true}
				SetState {Default2}
				Chat {/vt opt set idlepeacemode false}
~~ }
STATE: {ResetRun} ~~ {
	IF:	All
			Expr {testvar[DisableAttackSpeed]==0}
			Expr {getcharskill_traininglevel[47]==3}
		DO:	Chat {/vt opt set autoattackpower false}
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set enablenav true}
				Chat {/vt opt set enablelooting true}
				Chat {/vt opt set enablecombat true}
				Chat {/vt opt set enablebuffing false}
				SetState {Default3}
				Chat {/vt opt set autostack true}
				Chat {/vt opt set autocram true}
				Chat {/vt opt set navpriorityboost false}
				Chat {/vt opt set petrangemode 1}
				Chat {/vt opt set petmonsterdensity 2}
				Chat {/vt opt set summonpets false}
				Chat {/vt opt set Recharge-Norm-Mana 25}
				DoExpr {setvar[StopwatchRoomStart, stopwatchcreate[]];stopwatchstart[getvar[StopwatchRoomStart]]}
				Chat {/vt opt set TargetSelectMethod 2}
				Chat {}
~~ }
STATE: {Runback} ~~ {
	IF:	CellE 00AF0118
		DO:	EmbedNav nav128__ColoPortals_nav {ColoPortals.nav}
	IF:	CellE 00B0015C
		DO:	DoAll
				EmbedNav nav129__ColoDeathArena1_nav {ColoDeathArena1.nav}
				SetState {Runback2}
	IF:	CellE 00B1015C
		DO:	DoAll
				EmbedNav nav130__ColoDeathArena2_nav {ColoDeathArena2.nav}
				SetState {Runback2}
	IF:	CellE 00B2015C
		DO:	DoAll
				EmbedNav nav131__ColoDeathRouteArena3_nav {ColoDeathRouteArena3.nav}
				SetState {Runback2}
	IF:	CellE 00B3015C
		DO:	DoAll
				EmbedNav nav132__Arena4DeathRoute_nav {Arena4DeathRoute.nav}
				SetState {Runback2}
	IF:	CellE 00B4015C
		DO:	DoAll
				EmbedNav nav133__Arena5DeathRoute_nav {Arena5DeathRoute.nav}
				SetState {Runback2}
~~ }
STATE: {Runback2} ~~ {
	IF:	MobsInDist_Name 1 60 {}
		DO:	SetState {ColoBell}
	IF:	BlockE 00AF0000
		DO:	SetState {TurnIn}
	IF:	Expr {getvar[Follower]==1}
		DO:	DoAll
				DoExpr {clearvar[RoomCheck];clearvar[RoomNumber]}
				SetState {ColoBell}
				DoExpr {clearvar[FollowRunComplete]}
~~ }
STATE: {TicketCheck} ~~ {
	IF: ItemCountGE 1 {Colosseum Ticket}
		DO: DoAll
				Chat {/vt opt set enablebuffing true}
				EmbedNav nav140__empty_ {empty}  
				SetState {TicketTurnIn}
	IF: ItemCountLE 0 {Colosseum Ticket}
		DO: EmbedNav nav139__BuyTicket_nav {BuyTicket.nav}
~~ }
STATE: {TicketTurnIn} ~~ {
	IF: ChatMatch {^Your fellowship is now locked.}
		DO: SetState {ColoPortal}
	IF: SecsInStateGE 400
		DO: SetState {TurnIn}
	IF:	SecsInStateGE 30
		DO: EmbedNav nav138__Ticket_nav {Ticket.nav}
~~}
STATE: {TurnIn} ~~ {
	IF:	Always
		DO:	EmbedNav nav134___None_ {[none]}
	IF:	All
			ChatMatch {^You have won four Colosseum Coins!}
			Expr {getvar[Leader]==1}
		DO:	DoAll
				Chat {/f !turn in}
	IF:	Any
			ChatMatch {^Master Arbitrator tells you\, \"If you wish to fight}
			ChatMatch {^Master Arbitrator gives you}
		DO:	DoAll
				SetState {Door}
				DoExpr {clearvar[StopwatchSecond]}
				DoExpr {clearvar[Warning]}
				DoExpr {clearvar[Counter]}
				DoExpr {clearvar[Arrow]}
				DoExpr {clearvar[TurnIn]}
	IF:	Any
			ChatMatch {^\[Fellowship\] (|).* (say|says), \"!portal\"$}
			ChatMatch {^A Door appears on the North wall.}
			ChatMatch {^Congratulations! You have beaten the Colosseum!}
			MobsInDist_Name 1 30 {}
		DO:	SetState {ColoPortal}
	IF:	Any
			All
				Expr {getvar[TurnIn]==1}
				SecsInStateGE 15
			All
				Expr {getvar[TurnIn]<=0}
				Any
					ChatMatch {You fought in the Colosseum's}
					ChatMatch {You fellowship's Arena battles}
			SecsInStateGE 20
		DO:	DoAll
				SetState {TurnInTransition}
				DoExpr {clearvar[TurnIn]}
	IF:	Always
		DO:	DoAll
				Chat {/vt opt set enablebuffing false}
				Chat {/vt opt set enablenav true}
~~ }
STATE: {TurninChest} ~~ {
	IF:	ItemCountLE 0 {Colosseum Vault Key}
		DO:	DoAll
				SetState {Default}
	IF:	CellE 00AF0110
		DO:	SetState {Turninchest2}
	IF:	Not CellE 00AF0110
		DO:	EmbedNav nav135__ColoChest_nav {ColoChest.nav}
~~ }
STATE: {Turninchest2} ~~ {
	IF:	SecsInStateGE 1
		DO:	Chat {/mt use colosseum vault key on colosseum vault}
	IF:	SecsInStateGE 3
		DO:	Chat {/mt use colosseum vault}
	IF:	SecsInStateGE 17
		DO:	Chat {/mt use colosseum vault}
	IF:	SecsInStateGE 18
		DO:	SetState {TurninChest}
~~ }
STATE: {TurnInTransition} ~~ {
	IF:	ChatMatch {^\[Fellowship\].*(|).*(say|says), \"!turn in\"$}
		DO:	DoExpr {setvar[TurnIn, 1]}
	IF:	All
			Expr {testvar[StopwatchSecond]==1}
			Expr {testvar[Counter]==1}
			Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]-getvar[Counter]>=60}
		DO:	DoAll
				SetState {TurnIn}
				DoExpr {setvar[Counter, getvar[Counter]+60]}
	IF:	Always
		DO:	EmbedNav nav136___None_ {[none]}
	IF:	Any
			SecsInStateGE 30
			ChatMatch {\[Fellowship\] (|).* (say|says), \"!turn in\"$}
		DO:	DoAll
				SetState {TurnIn}
				Chat {/vt opt set enablebuffing false}
	IF:	Not BlockE 00AF0000
		DO:	EmbedNav nav137__ColoRecall_nav {ColoRecall.nav}
	IF:	CellE 00AF0118
		DO:	SetState {TurnIn}
	IF:	All
			Any
				Expr {isfalse[getvar[StopwatchSecond]]}
				All
					Expr {testvar[StopwatchSecond]==1}
					Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]>=3602}
				SecsInStateGE 30
			Any
				All
					SecsInStateGE 15
					Expr {isfalse[getvar[StopwatchSecond]]}
				All
					SecsInStateGE 5
					All
						Expr {testvar[StopwatchSecond]==1}
						Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]>=3605}
			Expr {getvar[Leader]==1}
		DO:	SetState {TurnIn}
	IF:	All
			All
				Expr {testvar[StopwatchSecond]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]>=3300}
			Expr {getvar[Warning]<=1}
			All
				Expr {testvar[StopwatchSecond]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]<=3500}
			All
				Expr {testvar[StopwatchSecond]==1}
				Expr {testvar[Counter]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]-getvar[Counter]<=59}
			Expr {getvar[Leader]==1}
		DO:	DoAll
				DoExpr {setvar[Warning, 2]}
				ChatExpr {\/f\ Time\ until\ turn\ in\ +cstrf[60-stopwatchelapsedseconds[getvar[StopwatchSecond]]/60, \F\0]+minutes}
	IF:	All
			All
				Expr {testvar[StopwatchSecond]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]>=3000}
			Expr {getvar[Warning]<=0}
			All
				Expr {testvar[StopwatchSecond]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]<=3299}
			All
				Expr {testvar[StopwatchSecond]==1}
				Expr {testvar[Counter]==1}
				Expr {stopwatchelapsedseconds[getvar[StopwatchSecond]]-getvar[Counter]<=59}
			Expr {getvar[Leader]==1}
		DO:	DoAll
				DoExpr {setvar[Warning, 1]}
				ChatExpr {\/f\ Time\ until\ turn\ in\ +cstrf[60-stopwatchelapsedseconds[getvar[StopwatchSecond]]/60, \F\0]+minutes}
	IF:	Expr {getvar[TurnInBuffing]==1}
		DO:	DoAll
				Chat {/vt opt set rebufftimeremainingseconds 5400}
				Chat {/vt opt set enablebuffing true}
~~ }

